/*
 * Version resource for EC.efi.
 *
 * A UEFI image is an ordinary PE/COFF file, so it carries a .rsrc section just
 * like a .sys or a .dll. Firmware ignores it - the loader only walks the
 * section table and the entry point - while Windows reads it, which is why
 * Explorer shows a Details tab for bootmgfw.efi and now for this driver too.
 *
 * Numeric constants are written out rather than pulled from <winver.h> so the
 * file compiles the same way whatever SDK the build machine has.
 */

1 VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L      /* VOS_NT_WINDOWS32 */
FILETYPE       0x1L          /* VFT_APP          */
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "WESMAR - Marek Wesolowski"
            VALUE "FileDescription",  "EFI Commander - dual-panel file manager for UEFI"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "EC.efi"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Marek Wesolowski (WESMAR)"
            VALUE "OriginalFilename", "EC.efi"
            VALUE "ProductName",      "EFI Commander"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "marek@wesolowski.eu.org - https://kvc.pl"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
